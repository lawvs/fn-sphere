---
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { ModuleSelector } from "../module-selector.tsx";

const { id, sidebar } = Astro.locals.starlightRoute;
const isolatedModules = ["sort", "flow"] as const;
const currentModule = isolatedModules.find((module) => id.startsWith(module));

const hasModuleLink = (
  entry: (typeof sidebar)[number],
  module: (typeof isolatedModules)[number],
): boolean => {
  if (entry.type === "link") return entry.href.includes(`/${module}/`);
  return entry.entries.some((child) => hasModuleLink(child, module));
};

Astro.locals.starlightRoute.sidebar = sidebar.filter((entry) =>
  currentModule
    ? hasModuleLink(entry, currentModule)
    : !isolatedModules.some((module) => hasModuleLink(entry, module)),
);
---

<ModuleSelector slug={id} client:load />
<Default {...Astro.props}><slot /></Default>
